# Pulse — Umgebungsvariablen für Produktivbetrieb
PORT=3000
# Öffentliche Domain (Installation oder manuell)
# DOMAIN=pulse.example.com
ADMIN_SECRET=bitte-langen-zufallswert-setzen
SQLITE_PATH=/data/pulse.db

# Benutzerverwaltung (Erstlogin per Kennwort, danach PIN wenn E-Mail konfiguriert)
USER_AUTH_ENABLED=1
# Entwicklung: 1 — Produktion/VPS-Installer: 0
AUTH_DEV_MAILBOX=1

# Erster Administrator (Klartext-Kennwort — wird serverseitig mit scrypt gehasht)
# Aliase: ADMIN_EMAIL / ADMIN_PASSWORD (Legacy-Namen, gleiche Bedeutung)
# NICHT verwenden: ADMIN_PASSWORD_HASH (wird in Pulse nicht ausgewertet)
BOOTSTRAP_ADMIN_NAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@localhost
BOOTSTRAP_ADMIN_PASSWORD=admin

# Auth-Cookie Secure-Flag: leer = automatisch (HTTPS ja, HTTP nein). 1/0 erzwingen.
# AUTH_COOKIE_SECURE=
# Docker: docker-compose.yml lädt .env per env_file — ohne Neustart nach Install-Update greift das Kennwort nicht.

# Demo-Event „Bürgerversammlung“ beim ersten Start (leerer events.json). 0 = aus.
# SEED_DEMO_EVENT=1

# SMTP optional — empfohlen über Admin-UI #/admin/email statt .env
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_TLS=starttls
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.org
# SMTP_FROM_NAME=Team Townhall
# --- Betriebsmodus (v1.5.4+) ---
# single = ein Prozess/Container, SQLite OK, Redis optional
# cluster = Mehrinstanz (Compose pulse+pulse-b), Redis + PostgreSQL erforderlich
# PULSE_OPERATION_MODE=single
# PULSE_EXPECT_INSTANCES=1
# PULSE_ALLOW_SQLITE_CLUSTER=0
# PULSE_STRICT_CLUSTER=1

# Optional PostgreSQL statt SQLite: npm i pg
# DATABASE_URL=postgres://pulse:pulse@postgres:5432/pulse
# Cluster-Compose (docker-compose.yml): REDIS_URL setzen. Einzelinstanz: docker-compose.single.yml
REDIS_URL=redis://redis:6379
BATCH_INTERVAL_MS=100
# 24h-IP-Sperre nach 100 WebSocket-Verbindungen derselben IP (Hash).
# Standard bei VPS-Installation: aus (IP_BLOCK=0).
IP_BLOCK=0

# Ohne REDIS_URL nur ein Node-Prozess (npm start). Mit REDIS_URL Fanout zwischen Prozessen.
# Compose setzt REDIS_URL und startet pulse + pulse-b hinter nginx ip_hash.

# Optional: Prefix für /css /js /assets in index.html (eigenes CDN, kein Pflicht-CDN).
# ASSET_BASE=https://cdn.example.de/pulse

# Optional: zusätzliche CORS-Origins (kommagetrennt). Standard: nur gleicher Host wie die Anfrage.
# CORS_ALLOWED_ORIGINS=https://embed.example.de

# HTTPS / Let's Encrypt (Admin-UI: #/admin/ssl)
# Zertifikatsdateien: SSL_DIR/<domain>/{privkey,cert,chain}.pem
# Standard lokal: data/ssl  — Produktiv z. B. SSL_DIR=/ssl
# HTTPS_PORT=3443
# SSL_DIR=data/ssl
# LETSENCRYPT_STAGING=1
# SSL_REDIRECT=1
# ACME_SKIP_VERIFY=1

# Automatische Updates (GitHub Releases — Admin: #/admin/updates)
UPDATE_REPO=markusringe/pulse
UPDATE_ENABLED=true
UPDATE_CHECK_INTERVAL=86400
UPDATE_ALLOW_PRERELEASE=false
UPDATE_AUTO_INSTALL=false
# GITHUB_TOKEN=ghp_xxx
# UPDATE_BACKUP_DIR=backups
# UPDATE_MAX_BACKUPS=10

# Vollständige Instanz-Backups (Admin: #/admin/backups)
# BACKUP_DIR=data/backups
# BACKUP_AUTO_ENABLED=1
# BACKUP_INTERVAL=daily
# BACKUP_RETENTION_DAYS=7
# BACKUP_INCLUDE_ENV=0
