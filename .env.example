# Pulse — Umgebungsvariablen für Produktivbetrieb
PORT=3000
ADMIN_SECRET=bitte-langen-zufallswert-setzen
SQLITE_PATH=/data/pulse.db

# Benutzerverwaltung (E-Mail-PIN-Login)
USER_AUTH_ENABLED=1
AUTH_DEV_MAILBOX=1

# Erster Administrator (wird nur angelegt, wenn noch kein Admin existiert)
BOOTSTRAP_ADMIN_NAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@localhost
BOOTSTRAP_ADMIN_PASSWORD=admin

# SMTP für Anmelde-PINs (Produktion erforderlich)
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_TLS=starttls
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.org
# SMTP_FROM_NAME=Team Townhall
# Optional PostgreSQL statt SQLite: npm i pg
# DATABASE_URL=postgres://pulse:pulse@postgres:5432/pulse
REDIS_URL=redis://redis:6379
BATCH_INTERVAL_MS=100
# 24h-IP-Sperre nach 100 WebSocket-Verbindungen derselben IP (Hash).
# 0/false/off deaktiviert fest (hat Vorrang vor Branding). Ungesetzt: Wert aus Branding (Standard: an).
# IP_BLOCK=0

# Ohne REDIS_URL nur ein Node-Prozess (npm start). Mit REDIS_URL Fanout zwischen Prozessen.
# Compose setzt REDIS_URL und startet pulse + pulse-b hinter nginx ip_hash.

# Optionaler Prefix für /css /js /assets in index.html (eigenes CDN, kein Pflicht-CDN).
# ASSET_BASE=https://cdn.example.de/pulse

# HTTPS / Let's Encrypt (Admin-UI: #/admin/ssl)
# Zertifikatsdateien: SSL_DIR/<domain>/{privkey,cert,chain}.pem
# Standard lokal: data/ssl  — Produktiv z. B. SSL_DIR=/ssl
# HTTPS_PORT=3443
# SSL_DIR=data/ssl
# LETSENCRYPT_STAGING=1
# SSL_REDIRECT=1
# ACME_SKIP_VERIFY=1

# Automatische Updates (GitHub Releases — Admin: #/admin/updates)
UPDATE_REPO=markusringe/pulse
UPDATE_ENABLED=true
UPDATE_CHECK_INTERVAL=86400
UPDATE_ALLOW_PRERELEASE=false
UPDATE_AUTO_INSTALL=false
# GITHUB_TOKEN=ghp_xxx
# UPDATE_BACKUP_DIR=backups
# UPDATE_MAX_BACKUPS=10
