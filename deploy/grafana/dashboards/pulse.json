  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "title": "WebSocket-Verbindungen",
      "type": "stat",
      "targets": [
        {
          "expr": "pulse_ws_connections",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "title": "Aktive Sessions",
      "type": "stat",
      "targets": [{ "expr": "pulse_sessions_active", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "title": "Stimmen / Wörter",
      "type": "stat",
      "targets": [
        { "expr": "rate(pulse_votes_total[5m])", "legendFormat": "Stimmen/s", "refId": "A" },
        { "expr": "rate(pulse_words_total[5m])", "legendFormat": "Wörter/s", "refId": "B" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 8 },
      "id": 4,
      "title": "HTTP-Latenz (p50 / p95)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(pulse_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(pulse_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 8 },
      "id": 5,
      "title": "WebSocket-Nachrichten",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(pulse_ws_messages_total[5m])) by (direction)",
          "legendFormat": "{{direction}}",
          "refId": "A"
        },
        {
          "expr": "rate(pulse_batches_total[5m])",
          "legendFormat": "Batches",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 17 },
      "id": 6,
      "title": "HTTP-Anfragen nach Route",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(pulse_http_requests_total[5m])) by (route, status)",
          "legendFormat": "{{route}} {{status}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["pulse", "websocket"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
